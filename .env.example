# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Optional: override the default model
# TRIP_CONCIERGE_MODEL=gemini-3.8-flash

# --- Phase 5, all optional; sensible safe defaults apply when unset ---

# Email sends a dry run (writes to outbox/) unless this is exactly "1".
# TRIP_CONCIERGE_EMAIL_SEND=1
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=trip-concierge@example.com

# Calendar uses the local stub unless set to "google" (then a token is required).
# TRIP_CONCIERGE_CALENDAR=google
# GOOGLE_CALENDAR_TOKEN=an-access-token-from-the-oauth-flow

# Sign-in for the Mail / Calendar connectors (Google and/or Microsoft). A provider
# is offered once its client id + secret and ENCRYPTION_KEY are set. Register the
# redirect URI in the Google Cloud / Azure app (nginx forwards it to the API).
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# MICROSOFT_CLIENT_ID=your-azure-app-id
# MICROSOFT_CLIENT_SECRET=your-azure-secret
# MICROSOFT_TENANT_ID=common
# OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
# Fernet key that encrypts stored tokens:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Optional: where reminders are stored (defaults to ./reminders.json)
# TRIP_CONCIERGE_REMINDERS=/path/to/reminders.json

# Web chat sessions: stored in this database when set, in memory otherwise.
# Docker Compose sets it to its own Postgres service; for a local run against that container:
# SESSION_DB_URL=postgresql+asyncpg://trip:trip@localhost:5433/trip_concierge

# Optional: live web search (Tavily) for the web concierge's agentic RAG.
# Unset, the agent searches only uploaded files and the curated guides.
# TAVILY_API_KEY=tvly-your-key

# Optional: where uploaded files are stored (defaults to ./uploads; compose uses a volume)
# UPLOAD_DIR=/path/to/uploads

# --- Accounts (email one-time codes) ---
# Codes are emailed over SMTP when SMTP_HOST is set (the SMTP_* settings above);
# without it (local dev) the code is printed in the API log, never returned.
# AUTH_SECRET=long-random-string
# Local testing only: make every sign-in code this value (ignored when SMTP_HOST is set).
# DEV_FIXED_OTP=123456   # keys the code/session hashes (defaults to ENCRYPTION_KEY)

# --- Memories (photos, videos, files) ---
# Stored in S3 when a bucket is set (uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION),
# under MEDIA_PREFIX; otherwise in MEDIA_DIR on disk.
# MEDIA_BUCKET=your-bucket          # or S3_ATTACHMENTS_BUCKET
# MEDIA_PREFIX=trip-concierge
# MEDIA_DIR=/path/to/media
# Place names typed for memories are geocoded with OpenStreetMap Nominatim (names only,
# never photo GPS). Set GEOCODER=off to disable.
# GEOCODER=nominatim
# App tables (users, trips, media); defaults to SESSION_DB_URL, else a local SQLite file.
# APP_DB_URL=postgresql+asyncpg://trip:trip@localhost:5433/trip_concierge

